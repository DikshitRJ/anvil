{
  "name": "anvil",
  "displayName": "Anvil — TrueForge Coding Agent",
  "description": "A VS Code coding agent whose agent loop runs on TrueForge, with per-hunk review, context engine and model relay.",
  "version": "0.1.0",
  "publisher": "anvil-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DikshitRJ/anvil"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:vscode": "node ./test/vscode/runTests.js",
    "package": "vsce package --no-dependencies -o anvil.vsix",
    "setup:trueforge": "node scripts/setup-trueforge.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.185.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.16",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
